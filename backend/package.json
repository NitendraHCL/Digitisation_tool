{
  "name": "lab-digitization-backend",
  "version": "1.0.0",
  "description": "Backend API for Lab Report Digitization System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/utils/seed.js",
    "lint": "eslint .",
    "lint:security": "eslint . --config eslint.config.security.js",
    "lint:fix": "eslint . --config eslint.config.security.js --fix",
    "lint:report": "eslint . --config eslint.config.security.js --format html --output-file eslint-security-report.html"
  },
  "keywords": [
    "lab",
    "digitization",
    "medical",
    "reports",
    "ai",
    "ocr"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.104.0",
    "p-limit": "^2.3.0",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rushstack/eslint-plugin-security": "^0.13.0",
    "eslint": "^9.39.1",
    "eslint-plugin-no-secrets": "^2.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-security-node": "^1.1.4",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
