# Server Configuration
NODE_ENV=development
PORT=5001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/lab_digitization

# Security - IMPORTANT: Change this in production!
JWT_SECRET=your-secure-jwt-secret-min-32-chars

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# AI API Keys (Optional - configure as needed)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# External Database Configuration (for Order ID validation and publishing)
# EXTERNAL_MONGODB_URI=your_external_mongodb_uri
# EXTERNAL_MONGODB_DB=your_external_db_name
# EXTERNAL_WRITE_MONGODB_URI=your_external_write_mongodb_uri
# EXTERNAL_WRITE_MONGODB_DB=your_external_write_db_name
