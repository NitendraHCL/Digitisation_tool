# ===========================================
# Lab Digitization System - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# ===========================================

# Server Configuration
NODE_ENV=development
PORT=5007
FRONTEND_URL=http://localhost:3000

# Local MongoDB Database
MONGODB_URI=mongodb://localhost:27017/lab-digitization-system

# External MongoDB Database (for Order ID validation)
# Contact your administrator for these credentials
EXTERNAL_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
EXTERNAL_MONGODB_DB=dev_kxhims

# External MongoDB Database (for publishing results)
# Contact your administrator for these credentials
EXTERNAL_WRITE_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
EXTERNAL_WRITE_MONGODB_DB=dev_kxhims

# AI API Keys
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: OpenAI API Key (if using GPT models)
OPENAI_API_KEY=

# Security
# Generate a strong random string for production
JWT_SECRET=your-secret-key-change-this-in-production

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=31457280

# GraphicsMagick Path (Windows only)
# Download from: http://www.graphicsmagick.org/
GM_PATH=C:\Program Files\GraphicsMagick-1.3.46-Q16\gm.exe
